# Supabase JS client (used by api/index.js)
# SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
#
# Must be the "service_role" secret key from Dashboard → Project Settings → API
# (long JWT starting with eyJ...). NOT the Postgres connection string.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

PORT=3001

# --- AI treatment insights (Groq — console.groq.com; keys start with gsk_) ---
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional xAI Grok (console.x.ai — different product):
# AI_PROVIDER=xai
# XAI_API_KEY=
# XAI_MODEL=grok-4.5
